# ==============================================================================
# HITSHARE PRODUCTION ENVIRONMENT CONFIGURATION (DOCKER)
# ==============================================================================
APP_NAME=HitShare
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hitshare.web.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ===== Docker Web Port Exposure =====
# Gunakan 80 jika Docker langsung menangani traffic port 80.
# Gunakan 8080 jika menggunakan Host Nginx / Cloudflare Tunnel sebagai reverse proxy.
WEB_PORT=80

# ===== Database MySQL (Docker Service: db) =====
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hitshare
DB_USERNAME=hitshare_user
DB_PASSWORD=GantiDenganPasswordDatabaseAman123!
DB_ROOT_PASSWORD=GantiDenganPasswordRootDatabaseAman123!

# ===== Cache, Session & Redis (Docker Service: redis) =====
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=local

# ===== Mail Server =====
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@hitshare.web.id"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Rate Limiting =====
LOGIN_RATE_MAX=50
LOGIN_RATE_WINDOW_MINUTES=15
REGISTER_RATE_MAX=20
REGISTER_RATE_WINDOW_MINUTES=60
CLICK_RATE_MAX=60

# ===== Paymenku Gateway =====
PAYMENKU_API_KEY=sk_live_ganti_dengan_api_key_produksi
PAYMENKU_WEBHOOK_SECRET=whsec_ganti_dengan_webhook_secret
PAYMENKU_IS_PRODUCTION=true

# ===== Frontend & Chrome Extension =====
FRONTEND_URL=https://hitshare.web.id
ALLOWED_EXTENSION_ID=
SANCTUM_EXPIRATION_MINUTES=43200
