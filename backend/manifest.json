{
    "manifest_version": 3,
    "name": "HitShare (Dev)",
    "version": "2.0.3",
    "version_name": "2.0.3",
    "description": "Akses semua web premium tanpa batas",
    "permissions": [
        "cookies",
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    }
}
